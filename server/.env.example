PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/tosswell
CLIENT_URL=http://localhost:5173

# AI provider: 'gemini' (default, cloud) | 'qvac' (local, no internet/API key needed)
# Switch to 'qvac' for fully offline local inference.
AI_PROVIDER=gemini

# Path to the folder containing @qvac/sdk in its node_modules
# Default: auto-resolved as ../qvac-test relative to server/src/
# Only needed when AI_PROVIDER=qvac
QVAC_DIR=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-hex
JWT_REFRESH_SECRET=replace-with-different-64-byte-hex
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# ── Qdrant (local vector DB for RAG support bot) ──────────────────────────────
# Start with: docker run -p 6333:6333 qdrant/qdrant
# Or via docker compose (included in docker-compose.yml)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tosswell_knowledge

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to log emails to the console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Tosswell Pizza <no-reply@tosswell.test>"

# ── Admin account (created by npm run seed) ───────────────────────────────────
ADMIN_EMAIL=admin@tosswell.test
ADMIN_PASSWORD=ChangeMe123

# ── Cloudinary (optional — enables admin image upload) ───────────────────────
# Free at cloudinary.com · Leave blank to use seeded Unsplash URLs + SVG fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Low-stock cron ────────────────────────────────────────────────────────────
STOCK_CRON=*/15 * * * *

# VAPID keys for browser push notifications
# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
