{
  "name": "tosswell-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "seed:images": "node src/seed-images.js",
    "seed:rag": "node src/rag-ingest.js",
